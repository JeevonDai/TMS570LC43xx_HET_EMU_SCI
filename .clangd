CompileFlags:
  Add:
    # 强制使用 C 语言模式（避免被识别为 C++ 或 Objective-C++）
    - -xc
    # 目标架构：ARM Cortex-R5
    - --target=arm-none-eabi
    - -mcpu=cortex-r5
    - -mfloat-abi=hard
    - -mfpu=vfpv3-d16
    - -marm
    # 项目包含路径
    - -I.
    - -IHALCoGen/include
    # TI 编译器系统头文件路径
    - -isystem
    - C:/ti/ccs1281/ccs/tools/compiler/ti-cgt-arm_20.2.7.LTS/include
    # - D:/ti/ccs1281/ccs/tools/compiler/ti-cgt-arm_20.2.7.LTS/include
    # 编译器选项
    - -fno-exceptions
    # 定义 TI 编译器宏
    - -D__TMS470__
    - -D__TI_ARM__
    - -D__LITTLE_ENDIAN__=0
    - -D__TI_COMPILER_VERSION__=20020700
    - -D__TMS570LC43xx__
    - -Dtrue=1
    - -Dfalse=0
    # 禁用大量警告（减少误报）
    - -Wno-everything
    - -ferror-limit=0
  Remove:
    # 移除可能导致语言识别错误的选项
    - -xc++
    - -xobjective-c++
    - -std=*
Diagnostics:
  # 禁用未使用和缺失包含的检查
  UnusedIncludes: None
  MissingIncludes: None
  # 抑制特定诊断
  Suppress:
    - unused-includes
    - missing-includes
    - drv_unknown_argument
    - unknown-warning-option
  # 禁用 ClangTidy
  ClangTidy:
    Remove:
      - '*'
Index:
  Background: Skip
  StandardLibrary: No

